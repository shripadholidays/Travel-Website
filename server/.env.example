# ─── Server ───────────────────────────────────────────────────────────────────
PORT=7654
NODE_ENV=development
API_PREFIX=/api/v1
BODY_LIMIT=10kb
GRACEFUL_SHUTDOWN_MS=10000

# ─── Database ─────────────────────────────────────────────────────────────────
DB_URI=mongodb://127.0.0.1:27017/wandeazy
DB_MAX_RETRIES=5
DB_RETRY_DELAY_MS=5000
DB_CONNECT_TIMEOUT_MS=30000
DB_SOCKET_TIMEOUT_MS=45000
DB_POOL_MAX_DEV=10
DB_POOL_MIN_DEV=2
DB_POOL_MAX_PROD=50
DB_POOL_MIN_PROD=10

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
SESSION_SECRET=change_me_to_another_long_random_string
JWT_TOKEN_MAX_AGE_DAYS=7
GOOGLE_ONE_TAP_MAX_AGE_MS=3600000
AUTH_COOKIE_NAME=wandeazy.token
AUTH_SID_COOKIE_NAME=wandeazy.sid
COOKIE_SAME_SITE=lax

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:7654/api/v1/auth/callback

# ─── CORS / Frontend origins ──────────────────────────────────────────────────
LOCAL_FRONTEND_ORIGIN=http://localhost:4321
PRODUCTION_FRONTEND_ORIGIN=https://your-domain.com

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_STRICT_WINDOW_MS=3600000
RATE_LIMIT_STRICT_MAX=10

# ─── Email (Mailgun) ──────────────────────────────────────────────────────────
MAILGUN_HOST=smtp.mailgun.org
MAILGUN_PORT=587
MAILGUN_SECURE=false
MAILGUN_DOMAIN=your_mailgun_domain.com
MAILGUN_API_KEY=your_mailgun_api_key
EMAIL_FROM_NAME=Wandeazy
EMAIL_FROM_ADDRESS=noreply@your_mailgun_domain.com
# Staff inbox that is told about new inquiries and confirmed bookings (optional)
ADMIN_NOTIFY_EMAIL=
EMAIL_BRAND_COLOR=#0F172A
EMAIL_ACCENT_COLOR=#F97316

# ─── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_DEFAULT_CURRENCY=USD

# ─── Pagination defaults ──────────────────────────────────────────────────────
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_ADMIN_DEFAULT_LIMIT=20
PAGINATION_SUBSCRIBERS_LIMIT=50
DASHBOARD_RECENT_LIMIT=5

# ─── Tours ────────────────────────────────────────────────────────────────────
TOURS_FEATURED_LIMIT=12
TOURS_FALLBACK_LIMIT=6

# ─── Mock auth (dev only — never enable in production) ────────────────────────
MOCK_AUTH=false
MOCK_USER_ID=mock-user-id
MOCK_USER_EMAIL=test@wandeazy.com
MOCK_USER_DISPLAY_NAME=Test User
MOCK_GOOGLE_ID=mock-google-id
