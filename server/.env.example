# ─── Server ───────────────────────────────────────────────────────────────────
PORT=7654
NODE_ENV=development
API_PREFIX=/api/v1
BODY_LIMIT=10kb
GRACEFUL_SHUTDOWN_MS=10000

# ─── Database ─────────────────────────────────────────────────────────────────
# Turso (libSQL). Leave both blank in local dev to use the SQLite file server/data/wandeazy.db.
# In production: the database URL (libsql://<name>-<org>.turso.io) and a token from the Turso dashboard
# or `turso db tokens create <name>`. Tables are created and migrated automatically on start.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ─── Auth / JWT ───────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_TOKEN_MAX_AGE_DAYS=7
GOOGLE_ONE_TAP_MAX_AGE_MS=3600000
AUTH_COOKIE_NAME=wandeazy.token
AUTH_SID_COOKIE_NAME=wandeazy.sid
COOKIE_SAME_SITE=lax

# ─── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:7654/api/v1/auth/callback

# ─── CORS / Frontend origins ──────────────────────────────────────────────────
LOCAL_FRONTEND_ORIGIN=http://localhost:4321
PRODUCTION_FRONTEND_ORIGIN=https://your-domain.com

# ─── Landing page cache ───────────────────────────────────────────────────────
# How long (ms) the home page's public data is remembered. Changes made through the API clear it at once.
# 0 turns it off.
PUBLIC_CACHE_TTL_MS=300000

# ─── Site rebuild ─────────────────────────────────────────────────────────────
# Deploy hook URL of the frontend (Vercel → Project → Settings → Git → Deploy Hooks). Called after tours,
# articles, destinations, collections, reviews or settings change, so new pages reach the prerender and
# the sitemap. Edits are grouped: one call once changes stop for SITE_REBUILD_DELAY_MS (default 2 min),
# at most SITE_REBUILD_MAX_WAIT_MS (default 15 min) after the first. Leave blank to rebuild by hand.
SITE_REBUILD_HOOK_URL=
SITE_REBUILD_DELAY_MS=120000
SITE_REBUILD_MAX_WAIT_MS=900000

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_API_WINDOW_MS=900000
RATE_LIMIT_API_MAX=1000
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_STRICT_WINDOW_MS=3600000
RATE_LIMIT_STRICT_MAX=10

# ─── Email (Mailgun) ──────────────────────────────────────────────────────────
MAILGUN_HOST=smtp.mailgun.org
MAILGUN_PORT=587
MAILGUN_SECURE=false
MAILGUN_DOMAIN=your_mailgun_domain.com
MAILGUN_API_KEY=your_mailgun_api_key
EMAIL_FROM_NAME=Wandeazy
EMAIL_FROM_ADDRESS=noreply@your_mailgun_domain.com
# Staff inbox that is told about new inquiries and confirmed bookings (optional)
ADMIN_NOTIFY_EMAIL=
EMAIL_BRAND_COLOR=#0F172A
EMAIL_ACCENT_COLOR=#F97316

# ─── Image uploads (Cloudflare R2) ────────────────────────────────────────────
# Set all five to store uploads in R2 (needed on Render, whose disk is wiped on deploy).
# Leave blank in local dev to save files in server/uploads.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public bucket URL: the r2.dev link or a custom domain, e.g. https://images.yourdomain.com
R2_PUBLIC_URL=
# Public URL of this API, used for uploads saved to local disk (Render fills RENDER_EXTERNAL_URL itself)
PUBLIC_API_URL=
MAX_UPLOAD_MB=10

# ─── Razorpay ─────────────────────────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys (use the rzp_test_ pair until you go live).
# Leave blank in local dev: bookings then confirm without payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks: URL https://<your-api>/api/v1/payments/webhook,
# events payment.captured, order.paid and payment.failed, then paste the secret here.
RAZORPAY_WEBHOOK_SECRET=
# Name shown at the top of the payment window
RAZORPAY_BRAND_NAME=Wandeazy

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Developers → API keys. Both keys stay on the server; the browser gets the publishable key from the API.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Developers → Webhooks: URL https://<your-api>/api/v1/payments/webhook (the same URL as Razorpay),
# events payment_intent.succeeded and payment_intent.payment_failed, then paste the signing secret here.
STRIPE_WEBHOOK_SECRET=

# With keys for both, Admin → Settings → Payments picks which one takes new payments.

# ─── Pagination defaults ──────────────────────────────────────────────────────
PAGINATION_DEFAULT_LIMIT=10
PAGINATION_ADMIN_DEFAULT_LIMIT=20
PAGINATION_SUBSCRIBERS_LIMIT=50
DASHBOARD_RECENT_LIMIT=5

# ─── Tours ────────────────────────────────────────────────────────────────────
TOURS_FEATURED_LIMIT=12
TOURS_FALLBACK_LIMIT=6

# ─── Mock auth (dev only — never enable in production) ────────────────────────
MOCK_AUTH=false
MOCK_USER_ID=mock-user-id
MOCK_USER_EMAIL=test@wandeazy.com
MOCK_USER_DISPLAY_NAME=Test User
MOCK_GOOGLE_ID=mock-google-id
