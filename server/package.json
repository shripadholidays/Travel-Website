{
  "name": "wondeazy-backend",
  "version": "1.0.0",
  "description": "Backend server for the Wondeazy tour and travel website.",
  "keywords": [
    "wandeazy",
    "tour",
    "travel",
    "backend",
    "express",
    "mongoose",
    "nodejs"
  ],
  "license": "ISC",
  "author": "Bhardwaj Rohan",
  "type": "commonjs",
  "main": "app.js",
  "scripts": {
    "test": "jest --runInBand",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "ratings:recompute": "node scripts/recompute-ratings.js",
    "content:clean": "node scripts/clean-placeholder-content.js",
    "db:migrate": "node -e \"require('dotenv').config();const db=require('./src/db');db.connect();require('./src/db/migrate').migrate().then(a=>{console.log(a.length?'Applied: '+a.join(', '):'Database is up to date');return db.close()})\"",
    "db:import-mongo": "node scripts/import-from-mongo.js",
    "seed": "node seed.js",
    "staff:test-accounts": "node scripts/create-test-staff.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1096.0",
    "@libsql/client": "^0.18.0",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.3.1",
    "google-auth-library": "^10.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^8.0.1",
    "razorpay": "^2.9.6",
    "sharp": "^0.35.5",
    "stripe": "^20.3.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "supertest": "^7.0.0"
  }
}
