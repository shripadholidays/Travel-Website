PORT=7654
NODE_ENV="development"
# Blank = local SQLite file (server/data/wandeazy.db); production = your Turso URL and token
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"
GOOGLE_CALLBACK_URL="http://localhost:7654/api/v1/auth/callback"
MOCK_AUTH=false

# Mailgun Email Service Configuration
MAILGUN_HOST="smtp.mailgun.org"
MAILGUN_PORT=587
MAILGUN_SECURE=false
MAILGUN_DOMAIN="your_mailgun_domain.com"
MAILGUN_API_KEY="your_mailgun_api_key"
# ── Flights & Hotels (switch on in Admin → Settings → Booking services) ──
FLIGHT_PROVIDER=mock          # mock | duffel
HOTEL_PROVIDER=mock           # mock | liteapi
FLIGHT_MARKUP_PCT=5           # defaults; admin settings override
HOTEL_MARKUP_PCT=8
PROVIDER_TIMEOUT_MS=15000
RATE_LIMIT_SEARCH_MAX=30      # searches per minute per IP
DUFFEL_API_KEY=
TRIPJACK_API_KEY=
LITEAPI_KEY=
# npm test always uses a throwaway in-memory database
