# ============================================================
# Wandeazy — Docker Compose environment
# Copy this file to ".env" and fill in the values, then run:
#   docker compose up --build
# ============================================================

# ---- Database (optional) ----
# Your Turso database. Leave blank to keep a SQLite file in a Docker volume.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Required (app + auth) ----
# A long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Frontend origin(s) the API will accept (CORS). Default works for local Docker.
LOCAL_FRONTEND_ORIGIN=http://localhost:3000
PRODUCTION_FRONTEND_ORIGIN=http://localhost:3000
COOKIE_SAME_SITE=lax

# Set MOCK_AUTH=true to bypass real auth in local/dev demos.
MOCK_AUTH=false

# ---- Frontend build-time vars (Vite) ----
VITE_API_URL=http://localhost:8080/api/v1
VITE_GOOGLE_OAUTH_CLIENT_ID=

# ---- Google OAuth (optional — leave blank to disable Google login) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/callback

# ---- Razorpay (optional — leave blank to disable payments) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Stripe (optional; with both set, choose in Admin → Settings → Payments) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Email / Mailgun (optional) ----
MAILGUN_HOST=
MAILGUN_PORT=
MAILGUN_SECURE=
MAILGUN_DOMAIN=
MAILGUN_API_KEY=
