{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/tour/:id", "destination": "/spa.html" },
    { "source": "/destinations/:slug", "destination": "/spa.html" },
    { "source": "/collections/:slug", "destination": "/spa.html" },
    { "source": "/blog/:slug", "destination": "/spa.html" },
    { "source": "/(flights|hotels|login|register|forgot-password|dashboard|book|write-article)", "destination": "/spa.html" },
    { "source": "/hotels/:id", "destination": "/spa.html" },
    { "source": "/(reset-password|verify-email|bookings)/:token", "destination": "/spa.html" },
    { "source": "/checkout/:path*", "destination": "/spa.html" },
    { "source": "/admin", "destination": "/spa.html" },
    { "source": "/admin/:path*", "destination": "/spa.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(spa|404)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
